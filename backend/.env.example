ADMIN_EMAIL=admin@example.com
# Local development may use ADMIN_PASSWORD instead of ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD=replace-with-a-local-dev-password
ADMIN_PASSWORD_HASH=replace-with-output-from-npm-run-hash-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ALLOW_LOCAL_VITE_ORIGINS=true
ADMIN_SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SAMESITE=Strict
PORT=3001
SUPABASE_URL=https://your-project.supabase.co
# Use the service-role key only in backend/.env.local or your server host.
# Never add it to frontend environment files.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_QUERY_LIMIT=1000
# The provision-admins command defaults to admin@agrisell.local and
# superadmin@agrisell.local. Supply its passwords only as temporary process
# environment variables; do not store bootstrap passwords in this file.
