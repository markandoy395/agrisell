{
  "name": "agrisell-admin",
  "homepage": "https://markandoy395.github.io/agrisell/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:deliveries": "node --test tests/delivery-api.test.mjs tests/delivery-database.test.mjs tests/delivery-cache.test.mjs",
    "test:orders": "node --test tests/order-api.test.mjs tests/order-database.test.mjs",
    "test:reviews": "node --test tests/review-api.test.mjs tests/review-moderation-database.test.mjs",
    "test:payments": "node --test tests/payment-api.test.mjs tests/payment-database.test.mjs",
    "test:notifications": "node --test tests/admin-notifications.test.mjs tests/broadcast-api.test.mjs",
    "test:commodities": "node --test tests/commodity-api.test.mjs",
    "test:admin-core": "node --test tests/admin-core-api.test.mjs tests/commodity-api.test.mjs tests/account-lifecycle-database.test.mjs tests/workspace-settings-database.test.mjs tests/keyboard-arrow-navigation.test.mjs",
    "test:keyboard": "node --test tests/keyboard-arrow-navigation.test.mjs",
    "test:api-db": "node --test tests/*-api.test.mjs tests/*-database.test.mjs tests/admin-notifications.test.mjs tests/global-issue.test.mjs tests/keyboard-arrow-navigation.test.mjs",
    "test:backend": "node --test ../backend/src/**/*.test.js ../backend/src/*.test.js",
    "test": "npm run test:api-db && npm run test:backend",
    "test:browser": "playwright test",
    "test:edge-types": "tsc --ignoreConfig --noEmit --target es2023 --lib es2023,dom --module esnext --moduleResolution bundler --allowImportingTsExtensions --skipLibCheck tests/edge-globals.d.ts ../supabase/functions/admin-api/index.ts",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "maplibre-gl": "^6.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
